# ===== Telegram API 凭据自助申请系统 · 配置模板 =====
# 使用：复制本文件为 .env 并填入真实值（.env 被 .gitignore 排除，真实配置不会提交）

# --- 代理（本项目要求配置 sticky 会话；住宅线路为部署建议，非官方保证）---
PROXY_SCHEME=socks5h
PROXY_HOST=住宅代理网关地址
PROXY_PORT=1080
PROXY_PASS=代理商密码
# 必填：使用代理商实际提供的 sticky 用户名语法，含 {session} 占位符。
# 下列仅为占位文本，不能作为任何代理商通用的用户名语法。
PROXY_USER_TEMPLATE=填写代理商用户名模板并包含{session}

# --- 服务 ---
# PORT 仅用于直接执行 python app/main.py；Uvicorn CLI 请使用 --port。
PORT=8000
# 接口文档 /docs：留空=关闭（公网部署必须关闭）；本地调试设为 1
ENABLE_DOCS=
# 统计数据库：相对路径以项目根目录为准，也可使用绝对路径。
# 目录需允许服务用户写入；自定义路径时同步调整服务的可写目录。
#STATS_DB_PATH=data/statistics.sqlite3

# --- PoW 人机验证难度 ---
# 客户端在 [0, maxnumber) 搜索 nonce；耗时取决于设备性能。
POW_MAXNUMBER=500000

# --- 运行参数（可选；不填=使用内置默认值，删除注释符即可生效）---
# .env 统一使用 python-dotenv 解析，支持引号和行尾注释；不展开 ${...}。
# 已存在的进程环境变量优先于本文件；整数参数必须为正数。
#TTL_SECONDS=600        # 申请流程有效期（秒）
#CODE_ATTEMPT_LIMIT=3   # 单流程验证码最大输错次数（输错也消耗 Telegram 频控配额）
#IP_SEND_LIMIT=5        # 每 IP 每小时验证码发送上限
#PHONE_COOLDOWN=180     # 同一手机号两次验证码发送最小间隔（秒）
#FLOW_SLOTS=5           # 全局并发在途流程上限
#POW_TTL=600            # PoW 挑战有效期（秒）
#POW_IP_LIMIT=20        # 每 IP 每分钟最多获取挑战次数
#POW_IP_PENDING_LIMIT=3 # 每 IP 最多保留未消费挑战数
#POW_POOL_LIMIT=8000    # 全局未消费挑战数上限
